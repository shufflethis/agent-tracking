# Copy to .env.production (or pass as container environment). Nothing here is optional
# for a working cloud install except the Stripe block and the log import.

# Where this installation answers. The snippet posts here; mails link here.
SITE_ORIGIN=https://agenttracking.co
SITE_NAME=Agent Tracking
CONTACT_EMAIL=hi@agenttracking.co

# Signs sessions, sign-in links and digest opt-out links. 32+ random bytes, base64 or hex.
UNLOCK_SECRET=

# Transactional mail through Brevo (https://www.brevo.com). The sender must be verified there.
BREVO_API_KEY=
MAIL_FROM_EMAIL=hi@agenttracking.co
MAIL_FROM_NAME=Agent Tracking

# The legal entity on the imprint, privacy notice, terms, DPA and mail footer.
# Address lines separated by |. A self-hoster must set their own entity here: once
# LEGAL_NAME is set, none of the cloud operator's other details are used as defaults.
LEGAL_NAME=FINAL MASTER LLC
LEGAL_FORM=Limited Liability Company (Florida, USA)
LEGAL_ADDRESS=7901 4th St N Ste 300|St. Petersburg, FL 33702|USA
LEGAL_EMAIL=hi@finalmaster.net
LEGAL_WEBSITE=https://finalmaster.net
LEGAL_EU_REPRESENTATIVE=
HOSTING_COUNTRY=Germany
HOSTING_PROVIDER=NexoSystems IT-Solutions, Niederzier, Germany
LEGAL_REVISED=2026-09-08

# The agent readiness check shown beside the numbers. Empty disables the score line.
CHECK_ORIGIN=https://webmcp-tool.com

# Hosts a customer's snippet may load agent.js from and still verify (comma separated).
LEGACY_SNIPPET_HOSTS=webmcp-tool.com

# Set to 0 to stop the site from carrying its own snippet.
SELF_TRACK=1

# Addresses that skip the rate limits, comma separated (your own monitors, the sister product's server).
RATELIMIT_EXEMPT=

# Stripe, only once paid plans are open. Absent means every account stays on Free.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=

# Server-log import (scripts/log-import.ts): path=domain pairs, comma separated.
LOG_IMPORT_SOURCES=/var/log/nginx/agenttracking.access.log=agenttracking.co

# Encrypted backup (scripts/backup-tracking.sh). Keep a copy of the key somewhere else.
TRACKING_BACKUP_KEY=
TRACKING_BACKUP_REPO=

# Optional: a Plausible script URL to count this site's own page views (cookieless). Empty loads nothing.
PLAUSIBLE_SCRIPT=
PLAUSIBLE_HOSTING=

# Optional byline and Article author for the guides (a person). Empty means the organisation is the author.
AUTHOR_NAME=
AUTHOR_URL=
AUTHOR_SAMEAS=

# Optional IndexNow key (any 32+ hex chars); served at /indexnow-key.txt. Submit with npm run indexnow.
INDEXNOW_KEY=
