{
  "name": "agent-tracking",
  "version": "0.1.0",
  "description": "Measure what AI agents do on your website: referrals, fetches, WebMCP tool calls and conversions. One line of script, no cookies, no personal data.",
  "license": "AGPL-3.0-only",
  "repository": { "type": "git", "url": "https://github.com/shufflethis/agent-tracking" },
  "homepage": "https://agenttracking.co",
  "private": true,
  "engines": { "node": ">=22.13" },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-snippet.mjs && next build",
    "start": "next start",
    "snippet": "node scripts/build-snippet.mjs",
    "test": "node scripts/build-snippet.mjs && tsx --test lib/*.test.ts lib/tracking/*.test.ts",
    "typecheck": "tsc --noEmit",
    "cron:nightly": "tsx --no-warnings scripts/tracking-cron.ts",
    "cron:logs": "tsx --no-warnings scripts/log-import.ts",
    "cron:digest": "tsx --no-warnings scripts/weekly-digest.ts"
  },
  "dependencies": {
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.12"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "typescript": "5.7.2"
  }
}
